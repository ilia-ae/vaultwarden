    "function": "generate_pin(mask_str: str, input_str: str) -> str",
    "algorithm": [
      "mask = [int(c) for c in mask_str]; must be exactly 8 values",
      "elements = list(''.join(input_str.strip().split())); must be exactly 20 code points",
      "pos_0 = mask[0] - 1; pos_i = (pos_{i-1} + mask[i]) % 20 for i >= 1",
      "out_i = elements[pos_i]; elements[pos_i] = '0'  (a revisited position yields '0')",
      "each mask value must be in 1..20 -> effectively 1..9 (single chars), checked inside the loop"
    ],
