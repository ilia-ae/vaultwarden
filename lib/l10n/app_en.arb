  "pinShiftPaperTitle": "How to compute this on paper",
  "pinShiftPaperIntroEncode": "Write the base PIN, write the vector underneath it, and add digit by digit modulo 10 — drop the tens place from any sum of 10 or more.",
  "pinShiftPaperIntroDecode": "Write the derived PIN, write the vector underneath it, and subtract digit by digit modulo 10 — add 10 to any negative result.",
  "pinShiftPaperLegend": "base — your {length}-digit base PIN · vec — your {length}-digit secret vector · new — the derived PIN.",
  "@pinShiftPaperLegend": {
