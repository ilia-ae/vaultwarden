    "validation_order": [
      "1. pin: falsy or not pin.isdigit() -> ValueError('PIN must be a non-empty digit string')",
      "2. shift: not isinstance(shift, str) -> TypeError(f'Shift must be a digit string, got {type(shift).__name__}')",
      "3. shift: empty or not shift.isdigit() -> ValueError('Shift must be a non-empty digit string')",
      "4. len(shift) != len(pin) -> ValueError(f'Shift length ({len(shift)}) must match PIN length ({len(pin)})')",
      "5. per-char int(): ValueError(\"invalid literal for int() with base 10: 'X'\") for isdigit-but-not-decimal chars (superscripts, circled digits)"
    ],
    "cli_behaviour": "cli.py catches ValueError only -> SystemExit(str(e)): message on stderr, exit status 1"
