    "function": "shift_pin(pin: str, shift: str, decode: bool = False) -> str",
    "formula": "out[i] = (int(pin[i]) + sign*int(shift[i])) mod 10 (Python floor-mod, result in 0..9); sign = -1 if decode else +1",
    "properties_checked": [
      "shift_pin(shift_pin(p, v, d), v, not d) == p for every vector",
      "shift_pin(p, v, decode=True) == shift_pin(p, complement(v), decode=False), complement(d) = (10-d) % 10"
    ],
